10 PRINT "VERSION 1.0"
20 PRINT "FOR LIST COMMANDS ENTER HELP"
30 WHILE 1 = 1
40 INPUT X$
500 IF X$ = "HELP" THEN GOTO 610
505 IF X$ = "READ" THEN GOTO 660
510 IF X$ = "INFO" THEN GOTO 680
515 IF X$ = "ALL" THEN GOTO 700
520 IF X$ = "PRNR" THEN GOTO 720
600 IF X$ = "ECHO" THEN GOTO 630
70 WEND
610 PRINT "HELP, ECHO, INFO, ALL, PRNR"
620 GOTO 30
630 INPUT "ECHO"; V$
640 PRINT V$
650 GOTO 30
660 INPUT N$
670 GOTO 30
680 PRINT "Version: 1.0, Name: DuckOS"
690 GOTO 30
700 PRINT "Version: 1.0, Name: DuckOS, CurrentDevice: hd0, code: BASIC"
710 GOTO 30
720 PRINT N$
730 GOTO 30